# ⚠️ SECURITY REQUIRED - Admin credentials MUST be set
# Copy this file to .env.local and fill in your credentials
# NEVER commit .env.local to Git or expose these credentials

# Required Admin Credentials (CHANGE THESE!)
VITE_ADMIN_USER=your_admin_username_here
VITE_ADMIN_PASS=your_secure_password_here

# Supabase (optional - for contact forms)
# VITE_SUPABASE_URL=your_supabase_url
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# 🚨 IMPORTANT: 
# - These credentials are REQUIRED for admin access
# - Use strong, unique passwords
# - Never share these credentials
# - .env.local is automatically ignored by Git
